# Postgres connection. Local: postgres://localhost:5432/pantau_bergizi — Prod: Neon *pooled* URL.
DATABASE_URL=postgres://localhost:5432/pantau_bergizi
# HMAC key for the session cookie, at least 32 chars. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me
# HMAC key for hashing IPs (and login emails) we never store raw, at least 32 chars. Generate: openssl rand -base64 48
IP_HASH_SECRET=change-me-change-me-change-me-change-me
# Bearer secret Vercel Cron sends to /api/cron/top-up. Generate: openssl rand -hex 32
CRON_SECRET=change-me-change-me-change-me-change-me
# "true" allows `bun run db:reset --yes`. Anything else blocks it.
DEMO_MODE=true
# Canonical site URL (scheme, no trailing slash) for school QR codes and share links. Prod: https://pantau-bergizi.vercel.app
PUBLIC_BASE_URL=http://localhost:3000
